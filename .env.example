# Read by Halo's native (Rust) backend at startup, from the directory Halo is
# launched in. Never exposed to the web frontend (Vite only exposes VITE_*).
# Alternatively, save the key from Halo's Settings into the OS credential store.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.6-flash and takes precedence over Settings.
GEMINI_MODEL=
